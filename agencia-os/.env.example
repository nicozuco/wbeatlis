# Runtime de la app: pooler de Supabase (Supavisor) en transaction mode.
# pgbouncer=true desactiva los prepared statements, incompatibles con este modo;
# connection_limit=1 evita que cada instancia serverless abra varias conexiones.
DATABASE_URL="postgresql://DB_ROLE.PROJECT_REF:DB_PASSWORD@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# Solo para migraciones (directUrl en schema.prisma): pooler en session mode, 5432.
# No se usa db.PROJECT_REF.supabase.co porque la conexión directa de Supabase es
# solo IPv6 y la mayoría de redes y entornos serverless no tienen IPv6.
DIRECT_URL="postgresql://DB_ROLE.PROJECT_REF:DB_PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Avisos push de la Agenda. Genera las claves con: npx web-push generate-vapid-keys
# VAPID_SUBJECT es opcional (por defecto, la URL de la app).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Secreto que pg_cron envía a /api/reminders/dispatch. El mismo valor va en
# Supabase Vault con el nombre reminders_cron_secret.
REMINDERS_CRON_SECRET=

NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_REPLACE_ME"
# Clave aleatoria de 32 bytes en base64 para cifrar las cuentas del gestor.
# Generar con: openssl rand -base64 32
VAULT_SERVER_KEY=
